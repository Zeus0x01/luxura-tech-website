// Luxura Tech USA LLC — database schema (PostgreSQL / Neon compatible).
//
// Conventions
//  - Every major model has id, createdAt, updatedAt.
//  - Table names are snake_case plurals (@@map) so the schema behaves the same
//    on hosts with case-sensitive and case-insensitive table names.
//  - Compatible with Neon PostgreSQL (and any standard Postgres).


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  QUALIFIED
  CLOSED
  ARCHIVED
}

enum ContactMethod {
  EMAIL
  PHONE
  EITHER
}

enum HomepageSectionKey {
  HERO
  ABOUT
  SERVICES
  HOW_WE_HELP
  INDUSTRIES
  WHY_LUXURA
  FINAL_CTA
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------------------
// Services & industries
// ---------------------------------------------------------------------------

model Service {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  shortDescription String            @db.VarChar(500)
  description      String            @db.Text
  /// One capability per line.
  capabilities     String            @db.Text
  businessValue    String?           @db.Text
  icon             String?
  coverImage       String?           @db.VarChar(500)
  status           ContentStatus     @default(DRAFT)
  featured         Boolean           @default(false)
  displayOrder     Int               @default(0)
  seoTitle         String?
  seoDescription   String?           @db.VarChar(320)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("services")
}

model Industry {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  shortDescription String            @db.VarChar(500)
  description      String            @db.Text
  challenges       String?           @db.Text
  solutions        String?           @db.Text
  icon             String?
  coverImage       String?           @db.VarChar(500)
  status           ContentStatus     @default(DRAFT)
  featured         Boolean           @default(false)
  displayOrder     Int               @default(0)
  seoTitle         String?
  seoDescription   String?           @db.VarChar(320)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("industries")
}

// ---------------------------------------------------------------------------
// Insights / articles
// ---------------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.VarChar(500)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  articles    Article[]

  @@map("categories")
}

model Article {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String?        @db.VarChar(500)
  content        String         @db.Text
  coverImage     String?        @db.VarChar(500)
  status         ContentStatus  @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?        @db.VarChar(320)
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Homepage sections (CMS)
// ---------------------------------------------------------------------------

model HomepageSection {
  id          String              @id @default(cuid())
  key         HomepageSectionKey  @unique
  title       String?
  subtitle    String?             @db.VarChar(500)
  body        String?             @db.Text
  ctaLabel    String?
  ctaHref     String?
  image       String?             @db.VarChar(500)
  /// JSON-like list of steps or items, one per line or structured text.
  items       String?             @db.Text
  featuredIds String?             @db.Text
  displayOrder Int                @default(0)
  isVisible   Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("homepage_sections")
}

// ---------------------------------------------------------------------------
// Leads / contact form
// ---------------------------------------------------------------------------

model Lead {
  id            String         @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  message       String         @db.Text
  preferredContact ContactMethod @default(EMAIL)
  status        LeadStatus     @default(NEW)
  source        String?        @db.VarChar(100)
  notes         String?        @db.Text
  emailSent     Boolean        @default(false)
  emailError    String?        @db.VarChar(500)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Site settings
// ---------------------------------------------------------------------------

model SiteSettings {
  id                    String   @id @default(cuid())
  companyName           String   @default("Luxura Tech USA LLC")
  tagline               String?  @db.VarChar(300)
  phone                 String?
  email                 String?
  address               String?  @db.VarChar(500)
  linkedinUrl           String?  @db.VarChar(500)
  twitterUrl            String?  @db.VarChar(500)
  facebookUrl           String?  @db.VarChar(500)
  instagramUrl          String?  @db.VarChar(500)
  youtubeUrl            String?  @db.VarChar(500)
  footerText            String?  @db.VarChar(500)
  defaultSeoTitle       String?
  defaultSeoDescription String?  @db.VarChar(320)
  defaultOgImage        String?  @db.VarChar(500)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Rate limiting (no Redis needed). `key` holds a hashed identifier.
// ---------------------------------------------------------------------------

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
  @@map("rate_limit_buckets")
}
