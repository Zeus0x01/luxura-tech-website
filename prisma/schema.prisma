// Luxura Tech USA LLC — database schema (PostgreSQL / Neon compatible).
//
// Conventions
//  - Every major model has id, createdAt, updatedAt.
//  - Table names are snake_case plurals (@@map) so the schema behaves the same
//    on hosts with case-sensitive and case-insensitive table names.
//  - Compatible with Neon PostgreSQL (and any standard Postgres).


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  QUALIFIED
  CLOSED
  ARCHIVED
}

enum ContactMethod {
  EMAIL
  PHONE
  EITHER
}

enum HomepageSectionKey {
  HERO
  ABOUT
  SERVICES
  HOW_WE_HELP
  INDUSTRIES
  WHY_LUXURA
  FINAL_CTA
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

// ---------------------------------------------------------------------------
// Services & industries
// ---------------------------------------------------------------------------

model Service {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  shortDescription String            @db.VarChar(500)
  description      String            @db.Text
  /// One capability per line.
  capabilities     String            @db.Text
  businessValue    String?           @db.Text
  icon             String?
  coverImage       String?           @db.VarChar(500)
  status           ContentStatus     @default(DRAFT)
  featured         Boolean           @default(false)
  displayOrder     Int               @default(0)
  seoTitle         String?
  seoDescription   String?           @db.VarChar(320)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  industries       ServiceIndustry[]
  leads            Lead[]

  @@index([status, displayOrder])
  @@index([featured])
  @@map("services")
}

model Industry {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String            @db.Text
  image          String?           @db.VarChar(500)
  icon           String?
  status         ContentStatus     @default(DRAFT)
  featured       Boolean           @default(false)
  displayOrder   Int               @default(0)
  seoTitle       String?
  seoDescription String?           @db.VarChar(320)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  services       ServiceIndustry[]

  @@index([status, displayOrder])
  @@index([featured])
  @@map("industries")
}

model ServiceIndustry {
  serviceId  String
  industryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([serviceId, industryId])
  @@index([industryId])
  @@map("service_industries")
}

// ---------------------------------------------------------------------------
// Insights (articles)
// ---------------------------------------------------------------------------

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@map("article_categories")
}

model Article {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  excerpt        String           @db.VarChar(600)
  /// Markdown. Rendered without raw HTML.
  content        String           @db.Text
  featuredImage  String?          @db.VarChar(500)
  author         String
  categoryId     String?
  status         ContentStatus    @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?          @db.VarChar(320)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Homepage content (edited from the admin dashboard)
// ---------------------------------------------------------------------------

model HomepageSection {
  id                String                @id @default(cuid())
  key               HomepageSectionKey    @unique
  enabled           Boolean               @default(true)
  title             String?
  subtitle          String?               @db.Text
  body              String?               @db.Text
  image             String?               @db.VarChar(500)
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             HomepageSectionItem[]

  @@map("homepage_sections")
}

model HomepageSectionItem {
  id           String          @id @default(cuid())
  sectionId    String
  title        String
  body         String          @db.Text
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  section      HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, displayOrder])
  @@map("homepage_section_items")
}

// ---------------------------------------------------------------------------
// Leads (contact form submissions) — private, never exposed publicly
// ---------------------------------------------------------------------------

model Lead {
  id                     String        @id @default(cuid())
  fullName               String
  company                String?
  email                  String
  phone                  String?
  country                String?
  serviceId              String?
  preferredContactMethod ContactMethod @default(EMAIL)
  message                String        @db.Text
  status                 LeadStatus    @default(NEW)
  internalNotes          String?       @db.Text
  /// Set when the Resend notification was accepted. NULL = not (yet) sent.
  notifiedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  service                Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
  @@index([serviceId])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Site settings (single row, id = "default")
// ---------------------------------------------------------------------------

model SiteSetting {
  id                    String   @id @default("default")
  companyName           String
  companyEmail          String?
  phone                 String?
  address               String?  @db.VarChar(500)
  logoUrl               String?  @db.VarChar(500)
  faviconUrl            String?  @db.VarChar(500)
  linkedinUrl           String?  @db.VarChar(500)
  xUrl                  String?  @db.VarChar(500)
  facebookUrl           String?  @db.VarChar(500)
  instagramUrl          String?  @db.VarChar(500)
  youtubeUrl            String?  @db.VarChar(500)
  footerText            String?  @db.VarChar(500)
  defaultSeoTitle       String?
  defaultSeoDescription String?  @db.VarChar(320)
  defaultOgImage        String?  @db.VarChar(500)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Rate limiting (no Redis needed). `key` holds a hashed identifier.
// ---------------------------------------------------------------------------

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
  @@map("rate_limit_buckets")
}
