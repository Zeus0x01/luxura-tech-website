# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon, Vercel Postgres, etc.)
# Neon example (use the *pooled* connection string for serverless / Vercel):
# postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# Auth.js secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Public URL of the site, no trailing slash. e.g. https://www.example.com
# (http://localhost:3000 for local development)
AUTH_URL=

# Resend API key (https://resend.com). Without it, leads are still saved but
# no notification email is sent.
RESEND_API_KEY=

# Where new-lead notifications are sent. Comma-separate for several recipients.
# Also used as the email of the first admin user created by `npm run db:seed`.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Sender for notification emails. Must be on a domain verified in Resend.
# Falls back to Resend's shared test sender (which can only email your own
# Resend account address).
EMAIL_FROM=

# Password for the first admin user (used only by `npm run db:seed`, only when
# the admin does not exist yet). If empty, a strong random password is
# generated and printed ONCE in the seed output.
ADMIN_INITIAL_PASSWORD=

# Comma-separated hostnames allowed for remote CMS images shown through
# next/image, e.g. images.example.com,cdn.example.com. Local /images/... files
# always work.
IMAGE_REMOTE_HOSTS=

# Extra origins allowed to call Server Actions (only if you serve the site on
# more than one hostname, e.g. apex + www). Comma-separated hostnames.
ALLOWED_ORIGINS=
